---
const checklist = [
  "Free hail and wind inspection, documented with photos",
  "We meet your adjuster on site and speak their language",
  "A straight answer on whether a claim is worth filing",
  "If the damage does not justify a claim, we tell you that too",
];
---

<section class="overflow-hidden bg-paper py-20 md:py-28">
  <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 sm:px-6 lg:grid-cols-2 lg:gap-16">
    <div data-reveal>
      <div class="overflow-hidden rounded-2xl shadow-(--shadow-lift)" data-parallax-bg="18">
        <picture>
          <source
            type="image/webp"
            srcset="/img/storm-768.webp 768w, /img/storm-1280.webp 1280w"
            sizes="(min-width: 1024px) 45vw, 92vw"
          />
          <img
            src="/img/storm.jpg"
            width="1280"
            height="996"
            alt="Storm clouds and hail moving over a suburban roof"
            loading="lazy"
            decoding="async"
            class="h-auto w-full object-cover"
          />
        </picture>
      </div>
    </div>

    <div data-reveal-group>
      <p class="kicker" data-reveal>Storm and hail claims</p>
      <h2 class="headline mt-3 text-3xl text-ink sm:text-4xl md:text-5xl" data-reveal>
        Hail hit your neighborhood? Your insurance may owe you a roof.
      </h2>
      <p class="mt-5 text-ink-soft" data-reveal>
        Cobb, Fulton, DeKalb, and Clayton counties take damaging hail most years, and the
        damage is usually invisible from the ground. If your roof qualifies, an approved
        claim means your insurer pays for the replacement and you cover your deductible.
        We document the damage, walk the roof with your adjuster, and tell you plainly
        whether a claim makes sense. No scare tactics.
      </p>
      <ul class="mt-6 space-y-3" data-reveal>
        {
          checklist.map((item) => (
            <li class="flex items-start gap-3">
              <svg
                viewBox="0 0 24 24"
                class="mt-0.5 h-5 w-5 shrink-0 text-brand"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="10" opacity="0.25" />
                <path d="m8 12.5 2.5 2.5L16 9.5" />
              </svg>
              <span class="text-ink">{item}</span>
            </li>
          ))
        }
      </ul>
      <div class="mt-8" data-reveal>
        <a href="#quote-tool" class="btn-ghost">Start with your instant estimate</a>
      </div>
    </div>
  </div>
</section>
