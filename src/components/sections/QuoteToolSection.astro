---
import QuoteFunnel from "../funnel/QuoteFunnel";
---

<section id="quote-tool" class="relative scroll-mt-20 overflow-hidden bg-paper-deep py-20 md:py-28">
  <!-- Blueprint accent, soft, right side -->
  <div class="pointer-events-none absolute inset-y-0 right-0 hidden w-[44%] md:block" aria-hidden="true">
    <picture>
      <source type="image/webp" srcset="/img/blueprint-1280.webp 1024w" sizes="44vw" />
      <img
        src="/img/blueprint.jpg"
        width="1024"
        height="1024"
        alt=""
        loading="lazy"
        decoding="async"
        class="blueprint-accent h-full w-full object-cover object-left"
      />
    </picture>
  </div>

  <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto max-w-2xl text-center" data-reveal-group>
      <p class="kicker" data-reveal>The 60 second estimate</p>
      <h2 class="headline mt-3 text-3xl text-ink sm:text-4xl md:text-5xl" data-reveal>
        Answer five questions. We measure the rest from space.
      </h2>
      <p class="mt-4 text-ink-soft" data-reveal>
        No obligation. No site visit needed for the range.
      </p>
    </div>

    <div class="relative mt-10 md:mt-12" data-reveal>
      <QuoteFunnel client:idle />
    </div>
  </div>
</section>

<style>
  .blueprint-accent {
    opacity: 0.14;
    mix-blend-mode: multiply;
    mask-image: linear-gradient(to left, black 30%, transparent 92%);
    -webkit-mask-image: linear-gradient(to left, black 30%, transparent 92%);
  }
</style>
